# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Clerk (https://dashboard.clerk.com -> API Keys) ---
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Plaid (https://dashboard.plaid.com/developers/keys) ---
PLAID_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
PLAID_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# sandbox | development | production
PLAID_ENV=sandbox
PLAID_CLIENT_NAME=My Finance App
# Only needed once you have a public URL (e.g. from ngrok or a deployment)
PLAID_WEBHOOK_URL=

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/finance_app?schema=public

# --- Encryption ---
# 32-byte key for AES-256-GCM, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit this. Store a copy in a password manager.
ENCRYPTION_KEY=
