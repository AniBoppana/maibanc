    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.10",
    "plaid": "^33.0.0",
    "react-plaid-link": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prisma": "^6.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "axios@1.18.1": true,
    "@clerk/clerk-react@5.61.9": true,
